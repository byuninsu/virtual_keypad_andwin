<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="4dp">

    <View
        android:id="@+id/overlayAbcdDrag"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:background="#88000000" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/overlayPrimaryButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/overlay_button_circle"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="A"
            android:textColor="#FF444444"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/overlaySecondaryButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/overlay_button_circle"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="B"
            android:textColor="#FF444444"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/overlayTertiaryButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/overlay_button_circle"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="C"
            android:textColor="#FF444444"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/overlayQuaternaryButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/overlay_button_circle"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="D"
            android:textColor="#FF444444"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
