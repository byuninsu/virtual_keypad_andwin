<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <Button
        android:id="@+id/overlayToggleButton"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/overlay_button_circle_small"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:text="@string/overlay_toggle"
        android:textColor="#FF2A2A2A"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/overlayPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 드래그 핸들 + 닫기 버튼 -->
        <LinearLayout
            android:id="@+id/overlayHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical|end"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/overlay_drag_handle"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/overlayCloseButton"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/overlay_button_circle_small"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="@string/overlay_close"
                android:textColor="#FF2A2A2A"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- F1~F5: 상단 중앙 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/overlayTop1Button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/overlay_button_circle_small"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="1"
                android:textColor="#FF2A2A2A"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/overlayTop2Button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/overlay_button_circle_small"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="2"
                android:textColor="#FF2A2A2A"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/overlayTop3Button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/overlay_button_circle_small"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="3"
                android:textColor="#FF2A2A2A"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/overlayTop4Button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/overlay_button_circle_small"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="4"
                android:textColor="#FF2A2A2A"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/overlayTop5Button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/overlay_button_circle_small"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="5"
                android:textColor="#FF2A2A2A"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 메인 영역: D-패드(좌) + ABCD(우) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- D-패드 -->
            <FrameLayout
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:background="@drawable/overlay_pad_background">

                <Button
                    android:id="@+id/overlayUpButton"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/overlay_button_circle"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="▲"
                    android:textColor="#FF444444"
                    android:textSize="24sp" />

                <Button
                    android:id="@+id/overlayLeftButton"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_gravity="center_vertical|start"
                    android:layout_marginStart="20dp"
                    android:background="@drawable/overlay_button_circle"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="◀"
                    android:textColor="#FF444444"
                    android:textSize="24sp" />

                <Button
                    android:id="@+id/overlayRightButton"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="20dp"
                    android:background="@drawable/overlay_button_circle"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="▶"
                    android:textColor="#FF444444"
                    android:textSize="24sp" />

                <Button
                    android:id="@+id/overlayDownButton"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/overlay_button_circle"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="▼"
                    android:textColor="#FF444444"
                    android:textSize="24sp" />
            </FrameLayout>

            <!-- A,B,C,D: D-패드 우측에 밀착, 겹침 없음 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:gravity="center"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/overlayPrimaryButton"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/overlay_button_circle"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:text="A"
                        android:textColor="#FF444444"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/overlaySecondaryButton"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/overlay_button_circle"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:text="B"
                        android:textColor="#FF444444"
                        android:textSize="24sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/overlayTertiaryButton"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/overlay_button_circle"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:text="C"
                        android:textColor="#FF444444"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/overlayQuaternaryButton"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/overlay_button_circle"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:text="D"
                        android:textColor="#FF444444"
                        android:textSize="24sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</FrameLayout>
