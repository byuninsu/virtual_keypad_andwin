<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/overlay_pad_background"
    android:padding="8dp">

    <!-- Row 1: [ ] [UP] [ ] -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Space
            android:layout_width="68dp"
            android:layout_height="68dp" />

        <Button
            android:id="@+id/overlayUpButton"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:background="@drawable/overlay_button_circle"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="▲"
            android:textColor="#FF444444"
            android:textSize="24sp" />

        <Space
            android:layout_width="68dp"
            android:layout_height="68dp" />
    </LinearLayout>

    <!-- Row 2: [LEFT] [ ] [RIGHT] -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/overlayLeftButton"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:background="@drawable/overlay_button_circle"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="◀"
            android:textColor="#FF444444"
            android:textSize="24sp" />

        <Space
            android:layout_width="68dp"
            android:layout_height="68dp" />

        <Button
            android:id="@+id/overlayRightButton"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:background="@drawable/overlay_button_circle"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="▶"
            android:textColor="#FF444444"
            android:textSize="24sp" />
    </LinearLayout>

    <!-- Row 3: [ ] [DOWN] [ ] -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Space
            android:layout_width="68dp"
            android:layout_height="68dp" />

        <Button
            android:id="@+id/overlayDownButton"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:background="@drawable/overlay_button_circle"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="▼"
            android:textColor="#FF444444"
            android:textSize="24sp" />

        <Space
            android:layout_width="68dp"
            android:layout_height="68dp" />
    </LinearLayout>
</LinearLayout>
